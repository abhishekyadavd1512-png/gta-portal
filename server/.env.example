DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gta_portal?schema=public"
JWT_SECRET="change-me-to-a-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Optional — Admin dashboard's "Trigger Offer Letter Flow" button (board
# feedback item 4, "Offer Letter — SharePoint"). Leave unset and the button
# stays disabled with an explanatory message; nothing is ever sent without
# both this being configured AND an admin explicitly clicking the button.
# Set this only after someone with Microsoft 365/Power Platform access has
# built and published the actual Power Automate flow and given you its
# HTTP-trigger URL.
# POWER_AUTOMATE_OFFER_LETTER_WEBHOOK_URL=""
# Optional extra header the flow can check for, on top of the webhook URL's
# own built-in signature.
# POWER_AUTOMATE_WEBHOOK_SECRET=""
